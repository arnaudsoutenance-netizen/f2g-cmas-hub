# F2G CMAS Hub - Environment Configuration

# App
APP_NAME="F2G CMAS Hub"
APP_VERSION="1.0.0"
DEBUG=true

# API
API_PREFIX="/api/v1"

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL="sqlite+aiosqlite:///./cmas_hub.db"
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/cmas_hub"

# Redis (optional, for job queue)
# REDIS_URL="redis://localhost:6379"

# JWT Authentication
SECRET_KEY="your-super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# eNodeB Configuration
ENB_DEFAULT_CONFIG_PATH="/etc/srsenb/sib.conf"
ENB_SSH_TIMEOUT=30

# CORS Origins (comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:5173"]
